# Copy to .env.local and fill in. Never commit real secrets.

# App database (local: the `tci` prisma dev server; see docs/SETUP.md).
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# Shadow database used only by `prisma migrate dev`.
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"

# Test database (the `tci-test` prisma dev server). `npm test` resets it on every run.
TEST_DATABASE_URL="postgres://postgres:postgres@localhost:51218/template1?sslmode=disable"

# Private document storage (Milestone 4). `dev` writes to .data/storage and refuses to run in production.
STORAGE_DRIVER="dev"
DEV_STORAGE_DIR=".data/storage"

# Identity provider (Milestone 2, not used yet). Placeholder names until D3 is confirmed.
# AUTH_PROVIDER=""
# AUTH_CLIENT_ID=""
# AUTH_CLIENT_SECRET=""
