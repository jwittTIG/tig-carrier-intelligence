# Copy to .env.local and fill in. Never commit real secrets.

# App database (local: the `tci` prisma dev server; see docs/SETUP.md).
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# Connection pool cap. Keep 1 for local prisma dev (PGlite); raise or remove for real Postgres.
DATABASE_POOL_MAX="1"
# Shadow database used only by `prisma migrate dev`.
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"

# Test database (the `tci-test` prisma dev server). `npm test` resets it on every run.
TEST_DATABASE_URL="postgres://postgres:postgres@localhost:51218/template1?sslmode=disable"
# Name of the local prisma dev test server; npm test restarts it first (PGlite gets unstable). Unset for real Postgres.
PRISMA_DEV_TEST_SERVER="tci-test"

# Private document storage (Milestone 4). `dev` writes to .data/storage and refuses to run in production.
STORAGE_DRIVER="dev"
DEV_STORAGE_DIR=".data/storage"
# Signs short-lived download links (32+ characters). Generate one per environment.
STORAGE_SIGNING_SECRET="replace-with-64-random-hex-characters-before-use-0000000000000000"

# Sign-in (DECISIONS D9). "clerk" = Microsoft 365 through Clerk. "dev" = DEVELOPMENT-ONLY
# picker of seeded users; refused when NODE_ENV=production.
AUTH_DRIVER="dev"
# Who may be invited and sign in (comma-separated). example.invalid is only for DEMO/TEST users.
ALLOWED_EMAIL_DOMAINS="tigknoxville.com,example.invalid"
# Clerk keys (from the Clerk dashboard, this app only). Leave blank until the Clerk app exists.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"

# Email intake (Milestone 6, DECISIONS D20; setup in docs/EMAIL_SETUP.md). Not used yet.
# "graph" reads the shared mailbox through Microsoft Graph; "dev" reads .eml files from a folder and refuses production.
MAIL_INTAKE_DRIVER="dev"
MAIL_INTAKE_DEV_DIR=".data/inbox"
MAIL_INTAKE_MAILBOX=""
MS_GRAPH_TENANT_ID=""
MS_GRAPH_CLIENT_ID=""
# Never commit or share this; keep it in the password manager.
MS_GRAPH_CLIENT_SECRET=""
# Protects /api/cron/mail-intake (32+ characters). Leave blank to disable the scheduled check.
CRON_SECRET=""
